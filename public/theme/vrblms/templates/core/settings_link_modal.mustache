{{!
    @template core/settings_link_modal

    theme_vrblms partial used by core/settings_link_page: the popup shown
    when a settings-group card is clicked. Lists the group's links using the
    unmodified core/settings_link_page_single partial (so nested groups and
    non-link headings render exactly as core does).

    Example context (json):
    {
        "text": "Badges",
        "key": "badges",
        "display": true,
        "action": "",
        "children": []
    }
}}
<div class="modal fade vrb-am-modal" id="vrb-am-{{key}}" tabindex="-1" aria-labelledby="vrb-am-{{key}}-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <span class="vrb-am-icon" data-key="{{key}}" aria-hidden="true"></span>
                <h2 class="modal-title" id="vrb-am-{{key}}-title">{{text}}</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{#str}} close, core {{/str}}"></button>
            </div>
            <div class="modal-body">
                <ul class="vrb-am-links list-unstyled">
                    {{#children}}
                        {{> core/settings_link_page_single }}
                    {{/children}}
                </ul>
            </div>
            {{#action}}
                <div class="modal-footer">
                    <a class="vrb-am-open" href="{{{action}}}">{{#str}} adminopencategory, theme_vrblms, {{text}} {{/str}}</a>
                </div>
            {{/action}}
        </div>
    </div>
</div>
