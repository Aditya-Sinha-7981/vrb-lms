{{!
    @template theme_vrblms/frontpage

    VRB LMS front page. A branded navy splash whose only job is to route
    the visitor to sign-in (or to "My courses" if already logged in).
    Reuses theme_moove's navbar/footer partials for the rest of the
    chrome; theme_moove/frontpage.mustache (the original demo template)
    is untouched.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes
    * herotitle - the big heading text
    * herosubtitle - the supporting line under the heading
    * secureportal - the "secure internal portal" caption
    * isloggedin - true if the visitor already has a session
    * loginurl - URL of the login page
    * mycoursesurl - URL of the "My courses" page

    Example context (json):
    {
        "sitename": "VRB LMS",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
         },
        "bodyattributes": "",
        "herotitle": "VRB Consumer Learning Platform",
        "herosubtitle": "Internal training for Veeba, Wok Tok and Zyro teams.",
        "secureportal": "Secure internal portal",
        "isloggedin": false,
        "loginurl": "https://example.com/login/index.php",
        "mycoursesurl": "https://example.com/my/courses.php"
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_moove/navbar }}

    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers drag-container bg-white">
        <section class="vrb-hero">
            <div class="vrb-hero__inner">
                <div class="vrb-hero__wordmark">VRB<span>LMS</span></div>
                <h1 class="vrb-hero__title">{{herotitle}}</h1>
                <p class="vrb-hero__subtitle">{{herosubtitle}}</p>
                <div class="vrb-hero__actions">
                    {{#isloggedin}}
                        <a class="btn btn-lg vrb-hero__cta" href="{{{mycoursesurl}}}">{{#str}}mycourses{{/str}}</a>
                    {{/isloggedin}}
                    {{^isloggedin}}
                        <a class="btn btn-lg vrb-hero__cta" href="{{{loginurl}}}">{{#str}}login{{/str}}</a>
                    {{/isloggedin}}
                </div>
                <p class="vrb-hero__secure">
                    <i class="fa fa-lock" aria-hidden="true"></i> {{secureportal}}
                </p>
            </div>
        </section>

        <div id="topofscroll">
            <div id="page-content" class="d-print-block main-inner">
                <div id="region-main-box" class="vrb-frontpage-hidden">
                    <section id="region-main" aria-label="{{#str}}content{{/str}}">
                        {{{ output.course_content_header }}}
                        {{{ output.main_content }}}
                        {{{ output.course_content_footer }}}
                    </section>
                </div>
            </div>
        </div>
    </div>
    {{> theme_moove/footer }}

    {{{ output.standard_after_main_region_html }}}
</div>

</body>
</html>
{{#js}}
    M.util.js_pending('theme_boost/loader');
    require(['theme_boost/loader', 'theme_boost/drawer'], function(Loader, Drawer) {
        Drawer.init();
        M.util.js_complete('theme_boost/loader');
    });
    {{! The VRB design is light-only — do not follow the OS dark-mode
        preference (the sitewide CSS also neutralises data-bs-theme=dark). }}
{{/js}}
