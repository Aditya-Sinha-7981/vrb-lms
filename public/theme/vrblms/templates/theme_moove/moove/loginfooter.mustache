{{!
    @template theme_moove/moove/loginfooter

    theme_vrblms override of theme_moove's login-page footer — same
    replacement as theme_moove/footer (WEBNOAH strip; debug output and
    end-of-body scripts preserved).

    Example context (json):
    {
        "output": {
            "debug_footer_html": "",
            "standard_end_of_body_html": ""
        }
    }
}}
<footer id="page-footer" class="vrb-footer">
    <div class="vrb-footer-strip">
        {{#str}} footercredit, theme_vrblms {{/str}} <strong>WEBNOAH</strong>
    </div>
    <div class="footer-content-debugging footer-dark bg-dark text-light">
        <div class="moove-container-fluid footer-dark-inner">
            {{{ output.debug_footer_html }}}
        </div>
    </div>
</footer>

{{{ output.standard_end_of_body_html }}}
