{{!
    @template theme_moove/footer

    theme_vrblms override of theme_moove's page footer. The stock footer
    (contact/social columns, "Contact site support", login info, data
    retention link, help popover, conecti.me credit) is replaced by a single
    "Designed and Developed by WEBNOAH" strip. Kept on purpose:
    output.debug_footer_html (developer debug output only) and
    output.standard_end_of_body_html (Moodle's end-of-page scripts) — both
    are required by core and must still be printed. Styling: style/custom.css
    section 3.

    Example context (json):
    {
        "output": {
            "debug_footer_html": "",
            "standard_end_of_body_html": ""
        }
    }
}}
<footer id="page-footer" class="vrb-footer">
    <div class="vrb-footer-strip">
        {{#str}} footercredit, theme_vrblms {{/str}} <strong>WEBNOAH</strong>
    </div>
    <div class="footer-content-debugging footer-dark bg-dark text-light">
        <div class="moove-container-fluid footer-dark-inner">
            {{{ output.debug_footer_html }}}
        </div>
    </div>
</footer>

{{{ output.standard_end_of_body_html }}}
