{{!
    @template block_myoverview/main

    theme_vrblms override of core's block_myoverview main template. The
    only change is the vrb-mycourses-intro heading prepended at the top,
    which turns the Course overview block into the brand-selection screen
    (see docs/design_refer/dashboard_vrb_learning_hub). Styling lives in
    theme/vrblms/style/custom.css section 6. The search, grouping, sort
    and display selectors and the courses-view partial below are copied
    verbatim from core and left untouched.
}}

<div id="block-myoverview-{{uniqid}}" class="block-myoverview block-cards" data-region="myoverview">
    <div class="vrb-mycourses-intro">
        <h2 class="vrb-mycourses-title">{{#str}} mycoursesheading, theme_vrblms {{/str}}</h2>
        <p class="vrb-mycourses-subtitle">{{#str}} mycoursessubtitle, theme_vrblms {{/str}}</p>
    </div>

    <div role="search" data-region="filter" class="d-flex align-items-center my-2" aria-label="{{#str}} aria:controls, block_myoverview {{/str}}">
        <div class="d-flex flex-wrap gap-1 align-items-center w-100">
            {{> block_myoverview/nav-grouping-selector }}

            {{!
                Override the `searchrole` block with an empty string to remove the `role="search"` landmark in
                `core/search_input_auto` used by the `block_myoverview/nav-search-widget` template.
                It is not necessary for the Course overview block that already has its own search landmark.
            }}
            {{< block_myoverview/nav-search-widget }}
                {{$searchrole}}{{/searchrole}}
            {{/ block_myoverview/nav-search-widget }}

            {{> block_myoverview/nav-sort-selector }}

            {{#displaydropdown}}
                {{> block_myoverview/nav-display-selector }}
            {{/displaydropdown}}
        </div>
    </div>

    <div class="container-fluid p-0">
        {{> block_myoverview/courses-view }}
    </div>
</div>
{{#js}}
require(
[
    'jquery',
    'block_myoverview/main',
],
function(
    $,
    Main
) {
    var root = $('#block-myoverview-{{uniqid}}');
    Main.init(root);
});
{{/js}}
